menu "Telemetry"
    menu "Sensor"
        config TELEMETRY_SENSOR_GPIO
            int "Sensor GPIO"
            default 22
            range 0 48
            help
                GPIO pin number with the sensor connected

        menu "Tune constants"
            config TELEMETRY_SENSOR_MESSAGE_TIME_INTERVAL
                int "Send sensor message time interval"
                default 60
                range 1 86400
                help
                    Time interval for sending sensor messages

            config TELEMETRY_SENSOR_ERROR_SLEEP_TIME
                int "Sensor sleep time on read error"
                default 1
                range 1 86400
                help
                    Sensor sleep time on read error

            config TELEMETRY_SENSOR_ERROR_THRASHOLD
                int "Sensor error trashold on read"
                default 10
                range 1 1000
                help
                    Sensor error trashold on read
            config TELEMETRY_SENSOR_ERROR_INIT_THRASHOLD
                int "Sensor error trashold on read"
                default 10
                range 1 1000
                help
                    Sensor error trashold on read
        endmenu
    endmenu

    menu "Wi-Fi Settings"
        config TELEMETRY_WIFI_SSID
            string "Wi-Fi SSID"
            help
                SSID (network name) for the Telemetry to connect to.

        config TELEMETRY_WIFI_PASSWORD
            string "Wi-Fi Password"
            help
                WiFi password (WPA or WPA2) for the Telemetry to use.

        menu "Tune constants"
            config TELEMETRY_WIFI_DISCONNECT_THRESHOLD
                int "Disconnect threshold"
                default 10
                range 1 1000
                help
                    Disconnect threshold before restart

            config TELEMETRY_WIFI_BAD_PASSWORD_SLEEP_TIME
                int "Wi-Fi reconnect timeout on bad password"
                default 60
                range 1 86400
                help
                    Wi-Fi reconnect timeout on bad password

            config TELEMETRY_WIFI_RECONNECT_SLEEP_TIME
                int "Default Wi-Fi reconnect timeout in seconds"
                default 30
                range 1 86400
                help
                    Default Wi-Fi reconnect timeout in seconds

            config TELEMETRY_WIFI_AP_SCAN_SLEEP_TIME
                int "Wi-Fi reconnect timeout for scan AP in seconds"
                default 1
                range 1 86400
                help
                    Wi-Fi reconnect timeout for scan AP in seconds

            config TELEMETRY_WIFI_ERROR_INIT_SLEEP_TIME
                int "Wi-Fi sleep time on init error"
                default 1
                range 1 86400
                help
                    Wi-Fi sleep time on init error

            config TELEMETRY_WIFI_ERROR_INIT_THRASHOLD
                int "Wi-Fi error trashold on init"
                default 10
                range 1 1000
                help
                    Wi-Fi error trashold on init
        endmenu
    endmenu

    menu "MQTT Settings"
        config TELEMETRY_MQTT_BROKER_URI
            string "MQTT broker URI"
            default "mqtt://mqtt_broker:1883"
            help
                MQTT broker URI

        config TELEMETRY_MQTT_USERNAME
            string "MQTT Username"
            help
                MQTT user

        config TELEMETRY_MQTT_PASSWORD
            string "MQTT Password"
            help
                MQTT password

        config TELEMETRY_MQTT_TOPIC
            string "MQTT Topic"
            default "/house/esp32"
            help
                MQTT topic with format house/*/sensor_name

        menu "Tune constants"
            config TELEMETRY_MQTT_LOST_WIFI_SLEEP_TIME
                int "MQTT lost Wi-Fi sleep seconds"
                default 1
                range 1 86400
                help
                    MQTT lost Wi-Fi wait time in seconds before send message again
        endmenu
    endmenu
endmenu
