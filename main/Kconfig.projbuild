menu "Telemetry"
config ESP_WIFI_SSID
    string "WiFi SSID"
    default "telemetry"
    help
    SSID (network name) for the Telemetry to connect to.

config ESP_WIFI_PASSWORD
    string "WiFi Password"
    default "telemetry"
    help
    WiFi password (WPA or WPA2) for the Telemetry to use.

config ESP_MQTT_BROKER_URI
    string "MQTT broker URI"
    default "mqtt://192.168.0.163:1883"

config ESP_MQTT_USERNAME
    string "MQTT Username"
    default "telemetry"

config ESP_MQTT_PASSWORD
    string "MQTT Password"
    default "telemetry"

config ESP_MQTT_TOPIC
    string "MQTT Topic"
    default "house/esp32"
endmenu
